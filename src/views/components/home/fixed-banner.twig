{#
| Variable                   | Type    | Description        |
|----------------------------|---------|--------------------|
| component                  | object  | Component settings |
| component.image            | string  | Banner image url   |
| component.title            | ?string | Banner title       |
| component.description      | ?string | Banner subtitle    |
| component.btn_text         | ?string | Button text        |
| component.btn_url          | ?string | Button link        |
| position                   | int     | Sorting number     |
#}

<style>
  .sana-banner { margin: 0 20px 40px; }
  .sana-banner .banner-inner {
    position: relative; height: 200px;
    border-radius: 4px; overflow: hidden;
  }
  .sana-banner .banner-inner img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
    display: block;
  }
  .sana-banner .banner-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.52);
    display: flex; align-items: center;
    justify-content: space-between; padding: 0 40px;
  }
  .sana-banner .banner-text { color: #fff; }
  .sana-banner .banner-heading {
    font-size: 26px; font-weight: 700; line-height: 1.2;
  }
  .sana-banner .banner-heading span { color: #e8c88a; }
  .sana-banner .banner-sub {
    font-size: 12px; color: rgba(255,255,255,0.75); margin-top: 6px;
  }
  .sana-banner .btn-banner {
    background: #e8dcc8; color: #1a1a1a;
    border: none; padding: 10px 22px;
    font-size: 11px; border-radius: 2px;
    cursor: pointer; font-weight: 600;
    letter-spacing: 0.5px; white-space: nowrap;
    text-decoration: none; display: inline-block;
    transition: background 0.25s;
  }
  .sana-banner .btn-banner:hover { background: #d4c4a8; }
  @media (max-width: 768px) {
    .sana-banner { margin: 0 12px 24px; }
    .sana-banner .banner-overlay { padding: 0 20px; }
    .sana-banner .banner-heading { font-size: 18px; }
  }
</style>

<section class="sana-banner s-block">
  <div class="banner-inner">
    <img src="{{ component.image }}" alt="{{ component.title }}" loading="lazy" />
    <div class="banner-overlay">
      <div class="banner-text">
        <div class="banner-heading">
          {% if component.title %}
            {{ component.title | replace({'&': '<span>&</span>'}) | raw }}
          {% else %}
            عروض <span>العيد</span> الفاخرة
          {% endif %}
        </div>
        {% if component.description %}
          <div class="banner-sub">{{ component.description }}</div>
        {% endif %}
      </div>
      {% if component.btn_url %}
        <a href="{{ component.btn_url }}" class="btn-banner">
          {{ component.btn_text ?? 'تسوق الآن' }}
        </a>
      {% endif %}
    </div>
  </div>
</section>
