{#
| Variable                        | Type     | Description           |
|---------------------------------|----------|-----------------------|
| component                       | object   | Component settings    |
| component.products              | object[] | List of products      |
| component.title                 | ?string  | Section title         |
| position                        | int      | Sorting number        |
#}

<style>
  .sana-products { padding: 40px 20px; }
  .sana-products .section-head {
    display: flex; align-items: baseline;
    justify-content: space-between; margin-bottom: 22px;
  }
  .sana-products .section-title {
    font-size: 18px; font-weight: 700; color: #1a1a1a;
    position: relative; display: inline-block;
  }
  .sana-products .section-title::after {
    content: ''; display: block; width: 32px; height: 2px;
    background: #b8966e; margin-top: 6px;
  }
  .sana-products .see-all {
    font-size: 11px; color: #b8966e; letter-spacing: 0.5px;
    text-decoration: none; transition: opacity 0.2s;
  }
  .sana-products .see-all:hover { opacity: 0.75; }
  .sana-products .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .sana-products .pcard {
    background: #fff; border: 0.5px solid #ede8e0;
    border-radius: 4px; overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }
  .sana-products .pcard:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.10);
    transform: translateY(-3px);
  }
  .sana-products .pcard-img {
    position: relative; width: 100%; height: 200px; overflow: hidden;
  }
  .sana-products .pcard-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s ease;
  }
  .sana-products .pcard:hover .pcard-img img { transform: scale(1.06); }
  .sana-products .pbadge {
    position: absolute; top: 10px; right: 10px;
    background: #b8966e; color: #fff;
    font-size: 9px; padding: 3px 8px; border-radius: 2px;
    font-weight: 700; letter-spacing: 0.5px;
  }
  .sana-products .pbadge-new { background: #1a1a1a; }
  .sana-products .pcard-info { padding: 12px 14px; }
  .sana-products .pname {
    font-size: 13px; font-weight: 500; color: #1a1a1a;
    margin-bottom: 3px; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .sana-products .pbrand {
    font-size: 10px; color: #aaa;
    letter-spacing: 0.5px; margin-bottom: 6px; text-transform: uppercase;
  }
  .sana-products .pstars { color: #b8966e; font-size: 10px; margin-bottom: 8px; }
  .sana-products .price-row {
    display: flex; align-items: center; justify-content: space-between;
  }
  .sana-products .pprice { font-size: 14px; font-weight: 700; color: #b8966e; }
  .sana-products .pold {
    font-size: 10px; color: #ccc;
    text-decoration: line-through; margin-left: 4px;
  }
  @media (max-width: 1024px) {
    .sana-products .products-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .sana-products .products-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
</style>

<section class="sana-products s-block">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">{{ component.title ?? 'الأكثر مبيعاً' }}</h2>
      <a href="/collections/featured" class="see-all">عرض الكل ←</a>
    </div>
    <div class="products-grid">
      {% for product in component.products %}
        <a href="{{ product.url }}" class="pcard">
          <div class="pcard-img">
            <img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy" />
            {% if product.is_new %}
              <span class="pbadge pbadge-new">جديد</span>
            {% elseif product.discount_percent %}
              <span class="pbadge">-{{ product.discount_percent }}%</span>
            {% endif %}
            <salla-add-product-button
              product-id="{{ product.id }}"
              class="absolute bottom-0 left-0 right-0 bg-dark bg-opacity-80 text-white text-center py-2 text-xs opacity-0 group-hover:opacity-100 transition-all">
            </salla-add-product-button>
          </div>
          <div class="pcard-info">
            <div class="pname">{{ product.name }}</div>
            <div class="pbrand">{{ product.brand ?? 'SANA HOME' }}</div>
            <div class="pstars">★★★★★</div>
            <div class="price-row">
              <div>
                {% if product.regular_price %}
                  <span class="pold">{{ product.regular_price }}</span>
                {% endif %}
                <span class="pprice">{{ product.price }} {{ store.currency }}</span>
              </div>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
