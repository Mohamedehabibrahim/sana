{#
| Variable                        | Type            | Description                                        |
|---------------------------------|-----------------|----------------------------------------------------|
| page                            | object          |                                                    |
| page.title                      | string          | "could be html"                                    |
| page.slug                       | string          | ex: "cat.show"                                     |
| product                         | Product         |                                                    |
| product.id                      | int             |                                                    |
| product.name                    | string          |                                                    |
| product.description             | string          | HTML                                               |
| product.url                     | string          |                                                    |
| product.promotion_title         | string          |                                                    |
| product.subtitle                | string          |                                                    |
| product.type                    | string          | product, service, group_products, codes, digital   |
| product.status                  | string          | sale, out, out-and-notify                          |
| product.rating                  | ?Rating         |                                                    |
| product.rating.count            | int             |                                                    |
| product.rating.stars            | int             |                                                    |
| product.price                   | float           |                                                    |
| product.sale_price              | float           |                                                    |
| product.regular_price           | float           |                                                    |
| product.quantity                | ?int            | if null means unlimited                            |
| product.image                   | object          |                                                    |
| product.image_url               | string          |                                                    |
| product.images                  | array           |                                                    |
| product.images[].url            | string          |                                                    |
| product.brand.name              | ?string         |                                                    |
| product.category.name           | ?string         |                                                    |
| product.category.url            | string          |                                                    |
| product.options                 | ProductOption[] |                                                    |
#}

{% extends "layouts.master" %}

{% block content %}

<style>
  .sana-product-page { max-width: 1280px; margin: 0 auto; padding: 0 20px 60px; }

  /* Breadcrumb */
  .sana-breadcrumb { padding: 14px 0; font-size: 11px; color: #999; max-width: 1280px; margin: 0 auto; padding-right: 20px; padding-left: 20px; }
  .sana-breadcrumb a { color: #999; text-decoration: none; transition: color 0.2s; }
  .sana-breadcrumb a:hover { color: #b8966e; }
  .sana-breadcrumb span { margin: 0 6px; }

  /* Layout */
  .sana-product-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }

  /* Gallery */
  .sana-gallery { position: sticky; top: 80px; }
  .sana-gallery-main {
    position: relative; border-radius: 4px; overflow: hidden;
    margin-bottom: 12px; background: #f5efe6;
  }
  .sana-gallery-main img {
    width: 100%; height: 500px; object-fit: cover;
    display: block; transition: transform 0.4s ease;
  }
  .sana-gallery-main:hover img { transform: scale(1.03); }
  .sana-gallery-badge {
    position: absolute; top: 16px; right: 16px;
    background: #b8966e; color: #fff;
    font-size: 11px; font-weight: 700;
    padding: 5px 12px; border-radius: 2px;
  }
  .sana-gallery-badge.out { background: #888; }
  .sana-gallery-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
  .sana-gallery-thumbs img {
    width: 76px; height: 76px; object-fit: cover;
    border-radius: 4px; cursor: pointer;
    border: 2px solid transparent;
    opacity: 0.7; transition: all 0.2s;
  }
  .sana-gallery-thumbs img.active,
  .sana-gallery-thumbs img:hover { border-color: #b8966e; opacity: 1; }

  /* Product Info */
  .sana-product-info { padding-top: 8px; }
  .sana-product-brand {
    font-size: 10px; color: #b8966e;
    letter-spacing: 2px; text-transform: uppercase;
    font-weight: 600; margin-bottom: 10px;
  }
  .sana-product-name {
    font-size: 26px; font-weight: 700;
    color: #1a1a1a; line-height: 1.3; margin-bottom: 12px;
  }
  .sana-product-subtitle {
    font-size: 13px; color: #888; margin-bottom: 14px;
  }

  /* Rating */
  .sana-rating {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 18px; padding-bottom: 18px;
    border-bottom: 0.5px solid #ede8e0;
  }
  .sana-stars { color: #b8966e; font-size: 14px; }
  .sana-rating-count { font-size: 12px; color: #888; }
  .sana-sold { font-size: 12px; color: #888; border-right: 1px solid #ede8e0; padding-right: 10px; }

  /* Price */
  .sana-price-block { margin-bottom: 20px; }
  .sana-price { font-size: 32px; font-weight: 700; color: #b8966e; }
  .sana-price-old {
    font-size: 16px; color: #ccc;
    text-decoration: line-through; margin-left: 8px;
  }
  .sana-price-save {
    font-size: 11px; background: #fef0f0; color: #c0392b;
    padding: 3px 10px; border-radius: 20px;
    font-weight: 600; margin-right: 8px; display: inline-block;
  }
  .sana-price-vat { font-size: 10px; color: #aaa; margin-top: 4px; }

  /* Options */
  .sana-option-block { margin-bottom: 18px; }
  .sana-option-label {
    font-size: 12px; font-weight: 600; color: #1a1a1a;
    margin-bottom: 10px; display: flex; justify-content: space-between;
  }
  .sana-option-label span { color: #b8966e; font-weight: 400; }

  /* Quantity */
  .sana-qty-block { margin-bottom: 22px; }
  .sana-qty-control {
    display: inline-flex; align-items: center;
    border: 1px solid #ede8e0; border-radius: 2px; overflow: hidden;
  }
  .sana-qty-btn {
    width: 40px; height: 42px; background: #f5efe6;
    border: none; font-size: 18px; cursor: pointer;
    color: #1a1a1a; transition: background 0.2s;
    font-family: inherit;
  }
  .sana-qty-btn:hover { background: #e8dcc8; }
  .sana-qty-input {
    width: 56px; height: 42px; border: none;
    border-right: 1px solid #ede8e0;
    border-left: 1px solid #ede8e0;
    text-align: center; font-size: 15px;
    font-weight: 600; color: #1a1a1a;
    background: #fff; font-family: inherit;
  }

  /* CTA */
  .sana-cta { display: flex; flex-direction: column; gap: 10px; margin-bottom: 22px; }
  .sana-btn-buynow {
    background: #b8966e; color: #fff; border: none;
    padding: 15px; font-size: 14px; font-family: inherit;
    font-weight: 700; border-radius: 2px; cursor: pointer;
    transition: background 0.25s; letter-spacing: 0.5px;
  }
  .sana-btn-buynow:hover { background: #a07c5a; }
  .sana-btn-cart {
    background: #1a1a1a; color: #fff; border: none;
    padding: 15px; font-size: 14px; font-family: inherit;
    font-weight: 600; border-radius: 2px; cursor: pointer;
    transition: background 0.25s;
  }
  .sana-btn-cart:hover { background: #2c2c2a; }
  .sana-btn-wish {
    background: transparent; color: #888;
    border: 1px solid #ede8e0; padding: 12px;
    font-size: 13px; font-family: inherit;
    border-radius: 2px; cursor: pointer;
    transition: all 0.25s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .sana-btn-wish:hover { border-color: #c0392b; color: #c0392b; }

  /* Guarantees */
  .sana-guarantees {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 10px; margin-bottom: 22px;
    padding: 16px; background: #faf9f7; border-radius: 4px;
  }
  .sana-guarantee { text-align: center; }
  .sana-guarantee-icon { font-size: 20px; margin-bottom: 4px; }
  .sana-guarantee-text strong { display: block; font-size: 11px; color: #1a1a1a; font-weight: 600; }
  .sana-guarantee-text span { font-size: 10px; color: #888; }

  /* Tabs */
  .sana-tabs { margin-top: 8px; }
  .sana-tab-nav {
    display: flex; border-bottom: 1px solid #ede8e0;
    margin-bottom: 20px;
  }
  .sana-tab-btn {
    padding: 11px 22px; font-size: 13px; font-family: inherit;
    background: none; border: none; color: #888; cursor: pointer;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: all 0.2s;
  }
  .sana-tab-btn.active { color: #1a1a1a; border-bottom-color: #b8966e; font-weight: 600; }
  .sana-tab-content { display: none; font-size: 14px; color: #666; line-height: 1.8; }
  .sana-tab-content.active { display: block; }
  .sana-tab-content ul { padding-right: 20px; }
  .sana-tab-content ul li { margin-bottom: 8px; list-style: disc; }

  /* Related */
  .sana-related { max-width: 1280px; margin: 0 auto; padding: 0 20px 60px; }
  .sana-related .section-head {
    display: flex; align-items: baseline;
    justify-content: space-between; margin-bottom: 20px;
  }
  .sana-related .section-title {
    font-size: 18px; font-weight: 700; color: #1a1a1a;
    position: relative; display: inline-block;
  }
  .sana-related .section-title::after {
    content: ''; display: block; width: 32px;
    height: 2px; background: #b8966e; margin-top: 6px;
  }

  /* Reviews */
  .sana-reviews { max-width: 1280px; margin: 0 auto; padding: 0 20px 40px; }
  .sana-reviews-head {
    display: flex; align-items: center;
    justify-content: space-between; margin-bottom: 20px;
  }
  .sana-rating-overview {
    display: flex; align-items: center; gap: 24px;
    background: #faf9f7; padding: 20px 24px;
    border-radius: 8px; margin-bottom: 20px;
  }
  .sana-rating-big { text-align: center; }
  .sana-rating-big .num { font-size: 48px; font-weight: 700; color: #1a1a1a; line-height: 1; }
  .sana-rating-big .stars { font-size: 18px; color: #b8966e; margin: 4px 0; }
  .sana-rating-big .count { font-size: 11px; color: #888; }

  @media (max-width: 768px) {
    .sana-product-layout { grid-template-columns: 1fr; gap: 24px; }
    .sana-gallery { position: static; }
    .sana-gallery-main img { height: 320px; }
    .sana-guarantees { grid-template-columns: 1fr 1fr; }
    .sana-product-name { font-size: 20px; }
  }
</style>

<!-- Breadcrumb -->
<div class="sana-breadcrumb">
  <a href="/">الرئيسية</a>
  <span>›</span>
  {% if product.category %}
    <a href="{{ product.category.url }}">{{ product.category.name }}</a>
    <span>›</span>
  {% endif %}
  <span>{{ product.name }}</span>
</div>

<div class="sana-product-page">
  <div class="sana-product-layout">

    <!-- Gallery -->
    <div class="sana-gallery">
      <div class="sana-gallery-main">
        <img id="sana-main-img"
          src="{{ product.image_url }}"
          alt="{{ product.name }}" />
        {% if product.status == 'sale' and product.regular_price %}
          <span class="sana-gallery-badge">
            -{{ ((product.regular_price - product.price) / product.regular_price * 100)|round }}%
          </span>
        {% elseif product.status == 'out' %}
          <span class="sana-gallery-badge out">نفد المخزون</span>
        {% endif %}
      </div>
      {% if product.images|length > 1 %}
        <div class="sana-gallery-thumbs">
          {% for image in product.images %}
            <img
              src="{{ image.url }}"
              alt="{{ product.name }}"
              class="{{ loop.first ? 'active' : '' }}"
              onclick="sanaSwitchImg(this, '{{ image.url }}')"
              loading="lazy"
            />
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="sana-product-info">

      {% if product.brand %}
        <div class="sana-product-brand">{{ product.brand.name }}</div>
      {% endif %}

      <h1 class="sana-product-name">{{ product.name }}</h1>

      {% if product.subtitle %}
        <div class="sana-product-subtitle">{{ product.subtitle }}</div>
      {% endif %}

      <!-- Rating -->
      {% if product.rating %}
        <div class="sana-rating">
          <div class="sana-sold">+{{ product.sold_quantity ?? 0 }} مبيعة</div>
          <div class="sana-stars">
            {% for i in 1..5 %}{{ i <= product.rating.stars ? '★' : '☆' }}{% endfor %}
          </div>
          <span class="sana-rating-count">{{ product.rating.stars }}.0 ({{ product.rating.count }} تقييم)</span>
        </div>
      {% endif %}

      <!-- Price -->
      <div class="sana-price-block">
        <div>
          {% if product.regular_price and product.regular_price != product.price %}
            <span class="sana-price-old">{{ product.regular_price }}</span>
            <span class="sana-price-save">
              وفّر {{ (product.regular_price - product.price)|round }} ر.س
            </span>
          {% endif %}
          <span class="sana-price">{{ product.price }} ر.س</span>
        </div>
        <div class="sana-price-vat">السعر شامل ضريبة القيمة المضافة</div>
      </div>

      <!-- Options -->
      {% if product.options %}
        {% for option in product.options %}
          <div class="sana-option-block">
            <div class="sana-option-label">{{ option.name }}</div>
            <salla-product-options product-id="{{ product.id }}"></salla-product-options>
          </div>
        {% endfor %}
      {% endif %}

      <!-- Quantity -->
      <div class="sana-qty-block">
        <div class="sana-option-label">الكمية</div>
        <div class="sana-qty-control">
          <button class="sana-qty-btn" onclick="sanaQty(-1)">−</button>
          <input class="sana-qty-input" type="number" id="sana-qty" value="1" min="1"
            {% if product.quantity %}max="{{ product.quantity }}"{% endif %} readonly />
          <button class="sana-qty-btn" onclick="sanaQty(1)">+</button>
        </div>
      </div>

      <!-- CTA -->
      <div class="sana-cta">
        {% if product.status != 'out' %}
          <salla-button
            onclick="salla.cart.addProduct({id: {{ product.id }}, quantity: document.getElementById('sana-qty').value})"
            class="sana-btn-buynow w-full">
            اشتري الآن
          </salla-button>
          <salla-add-product-button
            product-id="{{ product.id }}"
            class="sana-btn-cart w-full">
            أضف إلى السلة
          </salla-add-product-button>
        {% else %}
          <salla-notify-availability product-id="{{ product.id }}" class="w-full"></salla-notify-availability>
        {% endif %}
        <salla-favorite-button product-id="{{ product.id }}" class="sana-btn-wish w-full">
          ♡ &nbsp; أضف للمفضلة
        </salla-favorite-button>
      </div>

      <!-- Guarantees -->
      <div class="sana-guarantees">
        <div class="sana-guarantee">
          <div class="sana-guarantee-icon">🚚</div>
          <div class="sana-guarantee-text"><strong>شحن مجاني</strong><span>فوق 200 ر.س</span></div>
        </div>
        <div class="sana-guarantee">
          <div class="sana-guarantee-icon">↩️</div>
          <div class="sana-guarantee-text"><strong>إرجاع مجاني</strong><span>خلال 14 يوم</span></div>
        </div>
        <div class="sana-guarantee">
          <div class="sana-guarantee-icon">🎁</div>
          <div class="sana-guarantee-text"><strong>تغليف فاخر</strong><span>مجاناً</span></div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="sana-tabs">
        <div class="sana-tab-nav">
          <button class="sana-tab-btn active" onclick="sanaTab(this,'desc')">الوصف</button>
          <button class="sana-tab-btn" onclick="sanaTab(this,'ship')">الشحن</button>
        </div>
        <div id="desc" class="sana-tab-content active">
          {% if product.description %}
            {{ product.description|raw }}
          {% else %}
            <p>لا يوجد وصف متاح لهذا المنتج.</p>
          {% endif %}
        </div>
        <div id="ship" class="sana-tab-content">
          <ul>
            <li>التوصيل داخل الرياض: 1 — 2 يوم عمل</li>
            <li>باقي مناطق المملكة: 3 — 5 أيام عمل</li>
            <li>شحن مجاني للطلبات فوق 200 ر.س</li>
            <li>تغليف هدية مجاني عند الطلب</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Reviews -->
{% if product.rating %}
  <div class="sana-reviews">
    <div class="sana-reviews-head">
      <h2 style="font-size:18px;font-weight:700;color:#1a1a1a;position:relative;display:inline-block;">
        تقييمات العملاء
        <span style="display:block;width:32px;height:2px;background:#b8966e;margin-top:6px;"></span>
      </h2>
    </div>
    <div class="sana-rating-overview">
      <div class="sana-rating-big">
        <div class="num">{{ product.rating.stars }}.0</div>
        <div class="stars">
          {% for i in 1..5 %}{{ i <= product.rating.stars ? '★' : '☆' }}{% endfor %}
        </div>
        <div class="count">من {{ product.rating.count }} تقييم</div>
      </div>
    </div>
    <salla-ratings-reviews product-id="{{ product.id }}"></salla-ratings-reviews>
  </div>
{% endif %}

<!-- Related Products -->
<div class="sana-related">
  <div class="section-head">
    <h2 class="section-title">قد يعجبك أيضاً</h2>
    <a href="{{ product.category.url ?? '/collections' }}"
       style="font-size:11px;color:#b8966e;text-decoration:none;">عرض الكل ←</a>
  </div>
  <salla-related-products product-id="{{ product.id }}"></salla-related-products>
</div>

<script>
  function sanaSwitchImg(el, src) {
    document.getElementById('sana-main-img').src = src;
    document.querySelectorAll('.sana-gallery-thumbs img').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
  }
  function sanaQty(d) {
    const i = document.getElementById('sana-qty');
    const max = parseInt(i.max) || 99;
    i.value = Math.min(max, Math.max(1, parseInt(i.value) + d));
  }
  function sanaTab(btn, id) {
    document.querySelectorAll('.sana-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.sana-tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(id).classList.add('active');
  }
</script>

{% endblock %}

{% block scripts %}
  <script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
